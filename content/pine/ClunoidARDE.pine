// ═══════════════════════════════════════════════════════════════════════════
//  CLUNOID ARDE — Adaptive Regime Dual-Engine · Forex Majors · 15m
// ═══════════════════════════════════════════════════════════════════════════
//
//  This is not a new strategy invented for TradingView. It is a port of the
//  engine Clunoid already runs on Deriv MT5 (lib/deriv/mt5/strategy.ts and
//  ClunoidForexMT5.mq5), so a signal on this chart is the same signal the
//  bots take. The pair basket below is the one that survived three years of
//  backtesting — the expensive minors were dropped because the spread tax
//  alone sank them under every configuration tried.
//
//  HOW IT DECIDES
//  ──────────────
//  A regime classifier routes every bar to one of three states, and the
//  in-between state is the important one: it trades nothing. Standing aside
//  when the market has not made up its mind is what removes most whipsaw.
//
//    TREND         EMA 8/21/55 stacked, ADX ≥ gate, Choppiness < 38.2
//                  → Donchian(20) breakout, or a pullback to the Keltner
//                    mid that then re-breaks Donchian(10).
//                  → Stop at N×ATR. Target at minRR × that distance.
//
//    RANGE         ADX < 20 and Choppiness > 61.8
//                  → Fade a z-score(20) extreme confirmed by RSI.
//                  → Stop beyond the z≈±3 level, floored at 0.6×ATR so it
//                    never collapses to a noise-width stop.
//                  → Target the Bollinger mid — the mean it is reverting to.
//
//    TRANSITIONAL  Anything else. No new entries (Aggressive may take
//                  trend-direction trades at half size).
//
//  WHY IT DOES NOT REPAINT
//  ───────────────────────
//  Every calculation reads closed-bar values, entries are evaluated on bar
//  close, and alerts fire on barstate.isconfirmed. Nothing uses
//  request.security(), so there is no higher-timeframe lookahead to leak.
//  What you see on history is what you would have seen live. Most public
//  scripts showing spectacular results fail exactly this test.
//
//  READ THIS BEFORE TRADING IT
//  ───────────────────────────
//  A backtest is a hypothesis, not a promise. Defaults here include realistic
//  commission and slippage because a tester run without them is fiction.
//  Optimising the inputs until the curve looks beautiful is called
//  overfitting, and it is the most reliable way to lose money slowly. If you
//  change the parameters, verify on a date range you did not tune on.
//
//  Trading carries risk and you can lose money. Nothing here is advice.
//
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
strategy("Clunoid ARDE — Forex 15m",
     shorttitle       = "ARDE",
     overlay          = true,
     initial_capital  = 1000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value= 100,
     commission_type  = strategy.commission.percent,
     commission_value = 0.002,
     slippage         = 2,
     pyramiding       = 0,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     margin_long      = 0,
     margin_short     = 0)

// ── inputs ────────────────────────────────────────────────────────────────

grpP = "Risk profile"
profileIn = input.string("Moderate", "Profile", options = ["Conservative", "Moderate", "Aggressive"], group = grpP,
     tooltip = "Conservative: ADX gate 30, RR 2.0, widest stops, fewest trades.\nModerate: gate 25, RR 1.75.\nAggressive: gate 21, RR 1.2, also trades the transitional regime at half size.")

grpF = "Filters"
useSession  = input.bool(true,  "Trade session only",  group = grpF)
sessionIn   = input.session("0700-1900", "Session (exchange time)", group = grpF,
     tooltip = "Forex majors are worth trading when London and New York are awake. Outside those hours the spread is a larger share of a normal stop.")
maxPerDay   = input.int(4, "Max entries per day", minval = 1, maxval = 20, group = grpF,
     tooltip = "A day-trading cap. Without it a choppy session can produce a dozen marginal trades.")
spreadPips  = input.float(0.0, "Typical spread (pips, 0 = auto)", minval = 0, step = 0.1, group = grpF,
     tooltip = "Left at 0 the script uses a per-pair estimate calibrated from live Deriv bid/ask sampling. A signal is rejected when the spread is too large a share of its stop.")
maxSpreadPct= input.float(8.0, "Reject if spread > % of stop", minval = 1, maxval = 40, group = grpF)

grpV = "On the chart"
showZones   = input.bool(true, "Shade risk and reward", group = grpV)
showLevels  = input.bool(true, "Draw entry / stop / target", group = grpV)
showLabels  = input.bool(true, "Label each signal",    group = grpV)
showRegime  = input.bool(true, "Regime background",    group = grpV)
keepLast    = input.int(6, "Keep last N drawings", minval = 1, maxval = 40, group = grpV)

grpA = "Alerts"
alertsOn    = input.bool(true, "Send alerts", group = grpA)
channelTag  = input.string("", "Channel tag", group = grpA,
     tooltip = "Optional label carried in the alert payload — useful when several charts feed one webhook.")

// ── profile parameters (mirrors lib/deriv/mt5/profiles.ts) ─────────────────

isCons = profileIn == "Conservative"
isMod  = profileIn == "Moderate"

adxGate     = isCons ? 30.0 : isMod ? 25.0 : 21.0
atrTrailMlt = isCons ? 3.0  : isMod ? 2.5  : 2.0
minRR       = isCons ? 2.0  : isMod ? 1.75 : 1.2
tradeTrans  = not isCons and not isMod          // Aggressive only
riskPct     = isCons ? 0.4  : isMod ? 0.75 : 1.5

CHOP_TREND = 38.2
CHOP_RANGE = 61.8
MIN_BARS   = 120

// ── per-pair spread estimates, in pips ────────────────────────────────────
// Calibrated from live bid/ask sampling on Deriv. Anything not listed falls
// back to a deliberately pessimistic figure — better to skip a trade than to
// backtest a cost that was never real.

pairSpread() =>
    string s = syminfo.ticker
    float v  = 1.6
    if str.contains(s, "EURUSD")
        v := 0.6
    else if str.contains(s, "GBPUSD")
        v := 0.9
    else if str.contains(s, "USDJPY")
        v := 0.7
    else if str.contains(s, "USDCHF")
        v := 1.0
    else if str.contains(s, "AUDUSD")
        v := 0.8
    else if str.contains(s, "USDCAD")
        v := 1.0
    else if str.contains(s, "NZDUSD")
        v := 1.2
    v

// One pip on a 5- or 3-digit forex quote is ten ticks.
pipSize   = syminfo.mintick * 10
spreadUse = spreadPips > 0 ? spreadPips : pairSpread()
spreadAbs = spreadUse * pipSize

// ── indicators ────────────────────────────────────────────────────────────

e8  = ta.ema(close, 8)
e21 = ta.ema(close, 21)
e55 = ta.ema(close, 55)

atr14 = ta.atr(14)
[, , adx14] = ta.dmi(14, 14)

// Choppiness Index — Pine has no built-in, so compute it directly.
chopLen = 14
chop = 100 * math.log10(math.sum(ta.tr(true), chopLen) / (ta.highest(high, chopLen) - ta.lowest(low, chopLen))) / math.log10(chopLen)

dcHi = ta.highest(high, 20)
dcLo = ta.lowest(low, 20)
mcHi = ta.highest(high, 10)
mcLo = ta.lowest(low, 10)

kcMid = ta.ema(close, 20)
bbMid = ta.sma(close, 20)
bbDev = ta.stdev(close, 20)
zScore = bbDev > 0 ? (close - bbMid) / bbDev : 0.0
rsi14 = ta.rsi(close, 14)

// ── regime ────────────────────────────────────────────────────────────────

stackUp   = e8 > e21 and e21 > e55
stackDown = e8 < e21 and e21 < e55

isTrendUp   = adx14 >= adxGate and chop < CHOP_TREND and stackUp
isTrendDown = adx14 >= adxGate and chop < CHOP_TREND and stackDown
isRange     = adx14 < 20 and chop > CHOP_RANGE
isTrans     = not isTrendUp and not isTrendDown and not isRange

regimeName = isTrendUp ? "trend_up" : isTrendDown ? "trend_down" : isRange ? "range" : "transitional"

// ── gates ─────────────────────────────────────────────────────────────────

inSession = not useSession or not na(time(timeframe.period, sessionIn))
warmedUp  = bar_index >= MIN_BARS

var int dayCount = 0
if ta.change(time("D")) != 0
    dayCount := 0
underDayCap = dayCount < maxPerDay

flat = strategy.position_size == 0
canEnter = warmedUp and inSession and underDayCap and flat and barstate.isconfirmed

// ── TREND engine ──────────────────────────────────────────────────────────
// Breakout of the 20-bar channel in the stack direction, or a pullback to the
// Keltner mid that then re-breaks the 10-bar channel.

trendSetup(bool isLong) =>
    float stopD = atrTrailMlt * atr14
    bool brokeOut = isLong ? close >= dcHi : close <= dcLo
    bool pulled   = isLong ? close <= kcMid * 1.001 : close >= kcMid * 0.999
    bool micro    = isLong ? close >= mcHi : close <= mcLo
    bool trigger  = brokeOut or (pulled and micro)
    float sl = isLong ? close - stopD : close + stopD
    float tp = isLong ? close + minRR * stopD : close - minRR * stopD
    [trigger and stopD > 0, sl, tp, stopD, brokeOut]

// ── RANGE engine ──────────────────────────────────────────────────────────
// Fade a stretched z-score confirmed by RSI, targeting the mean. Skip when
// price is so stretched (|z| ≥ 3) that fading it is catching a falling knife.

rangeSetup() =>
    bool  wantLong  = zScore <= -2 and rsi14 <= 30
    bool  wantShort = zScore >=  2 and rsi14 >= 70
    bool  tooFar    = math.abs(zScore) >= 3
    bool  isLong    = wantLong
    float sd        = math.abs(zScore) > 0 ? math.abs(close - bbMid) / math.abs(zScore) : atr14
    float stopD     = math.max(0.6 * atr14, (3 - math.abs(zScore)) * sd)
    float sl        = isLong ? close - stopD : close + stopD
    float tp        = bbMid
    float rr        = stopD > 0 ? math.abs(tp - close) / stopD : 0
    [(wantLong or wantShort) and not tooFar and rr >= 1.0, isLong, sl, tp, stopD]

// ── evaluate ──────────────────────────────────────────────────────────────

var float pendEntry = na
var float pendSL    = na
var float pendTP    = na
var string pendWhy  = ""
var int   pendConf  = 0

bool  goLong  = false
bool  goShort = false
float useSL   = na
float useTP   = na
float useStop = na
string why    = ""
int   conf    = 0

if canEnter
    if isTrendUp or isTrendDown
        bool isLong = isTrendUp
        [ok, sl, tp, stopD, brokeOut] = trendSetup(isLong)
        if ok
            goLong  := isLong
            goShort := not isLong
            useSL   := sl
            useTP   := tp
            useStop := stopD
            why     := "Trend " + (isLong ? "up" : "down") + " · ADX " + str.tostring(adx14, "#") + " · " + (brokeOut ? "channel breakout" : "pullback continuation")
            conf    := math.round(math.min(95, 58 + math.min(1, math.max(0, (adx14 - adxGate) / 25)) * 34))
    else if isRange
        [ok, isLong, sl, tp, stopD] = rangeSetup()
        if ok
            goLong  := isLong
            goShort := not isLong
            useSL   := sl
            useTP   := tp
            useStop := stopD
            why     := "Range fade · z " + str.tostring(zScore, "#.#") + " · RSI " + str.tostring(rsi14, "#")
            conf    := math.round(math.min(88, 52 + (math.abs(zScore) - 2) * 20))
    else if isTrans and tradeTrans and (stackUp or stackDown)
        bool isLong = stackUp
        [ok, sl, tp, stopD, brokeOut] = trendSetup(isLong)
        if ok
            goLong  := isLong
            goShort := not isLong
            useSL   := sl
            useTP   := tp
            useStop := stopD
            why     := "Transitional " + (isLong ? "up" : "down") + " (half size) · " + (brokeOut ? "channel breakout" : "pullback continuation")
            conf    := 62

// Cost gate — a stop the spread eats is not an edge, it is a donation.
spreadOk = not na(useStop) and useStop > 0 and (spreadAbs / useStop) * 100 <= maxSpreadPct
if (goLong or goShort) and not spreadOk
    goLong  := false
    goShort := false

// ── execute ───────────────────────────────────────────────────────────────

if goLong
    strategy.entry("L", strategy.long, comment = "ARDE long")
    strategy.exit("L x", from_entry = "L", stop = useSL, limit = useTP, comment_loss = "SL", comment_profit = "TP")
    dayCount += 1

if goShort
    strategy.entry("S", strategy.short, comment = "ARDE short")
    strategy.exit("S x", from_entry = "S", stop = useSL, limit = useTP, comment_loss = "SL", comment_profit = "TP")
    dayCount += 1

// ── draw it ───────────────────────────────────────────────────────────────

C_LONG  = color.new(#26a69a, 0)
C_SHORT = color.new(#ef5350, 0)
C_RISK  = color.new(#ef5350, 88)
C_REW   = color.new(#26a69a, 88)
C_TEXT  = color.new(#eaf2fb, 0)

var array<line>  lines = array.new<line>()
var array<box>   boxes = array.new<box>()
var array<label> labs  = array.new<label>()

prune(array<line> ls, array<box> bs, array<label> lb) =>
    while array.size(ls) > keepLast * 3
        line.delete(array.shift(ls))
    while array.size(bs) > keepLast * 2
        box.delete(array.shift(bs))
    while array.size(lb) > keepLast
        label.delete(array.shift(lb))

if (goLong or goShort)
    col = goLong ? C_LONG : C_SHORT
    rightEdge = bar_index + 24

    if showLevels
        array.push(lines, line.new(bar_index, close,  rightEdge, close,  color = col,     width = 2, style = line.style_solid))
        array.push(lines, line.new(bar_index, useSL,  rightEdge, useSL,  color = C_SHORT, width = 1, style = line.style_dashed))
        array.push(lines, line.new(bar_index, useTP,  rightEdge, useTP,  color = C_LONG,  width = 1, style = line.style_dashed))

    if showZones
        array.push(boxes, box.new(bar_index, close, rightEdge, useSL, border_color = color.new(#ef5350, 60), bgcolor = C_RISK))
        array.push(boxes, box.new(bar_index, close, rightEdge, useTP, border_color = color.new(#26a69a, 60), bgcolor = C_REW))

    if showLabels
        rrTxt = str.tostring(math.abs(useTP - close) / math.max(useStop, syminfo.mintick), "#.##")
        txt = (goLong ? "▲ LONG " : "▼ SHORT ") + syminfo.ticker + "\n" +
              "Entry " + str.tostring(close, format.mintick) + "\n" +
              "Stop  " + str.tostring(useSL, format.mintick) + "\n" +
              "Target " + str.tostring(useTP, format.mintick) + "\n" +
              "RR " + rrTxt + " · confidence " + str.tostring(conf) + "%"
        array.push(labs, label.new(bar_index, goLong ? low : high,
             text = txt, color = color.new(col, 12), textcolor = C_TEXT, size = size.small,
             style = goLong ? label.style_label_up : label.style_label_down))

    prune(lines, boxes, labs)

bgcolor(showRegime ? (isTrendUp ? color.new(#26a69a, 94) : isTrendDown ? color.new(#ef5350, 94) : isRange ? color.new(#42a5f5, 95) : na) : na)

plot(e21, "EMA 21", color = color.new(#38bdf8, 45), linewidth = 1)
plot(e55, "EMA 55", color = color.new(#93a7bd, 60), linewidth = 1)

// ── alerts ────────────────────────────────────────────────────────────────
// One JSON object, so the receiving webhook parses rather than guesses. The
// secret is NOT placed here — it belongs in the alert's webhook URL, which is
// never visible on a published chart.

if alertsOn and (goLong or goShort) and barstate.isconfirmed
    side = goLong ? "buy" : "sell"
    rr   = math.abs(useTP - close) / math.max(useStop, syminfo.mintick)
    json = '{"source":"clunoid-arde","v":1' +
         ',"symbol":"'    + syminfo.ticker + '"' +
         ',"exchange":"'  + syminfo.prefix + '"' +
         ',"timeframe":"' + timeframe.period + '"' +
         ',"side":"'      + side + '"' +
         ',"regime":"'    + regimeName + '"' +
         ',"profile":"'   + profileIn + '"' +
         ',"entry":'      + str.tostring(close,  format.mintick) +
         ',"stop":'       + str.tostring(useSL,  format.mintick) +
         ',"target":'     + str.tostring(useTP,  format.mintick) +
         ',"rr":'         + str.tostring(rr, "#.##") +
         ',"riskPct":'    + str.tostring(riskPct, "#.##") +
         ',"confidence":' + str.tostring(conf) +
         ',"adx":'        + str.tostring(adx14, "#.#") +
         ',"chop":'       + str.tostring(chop,  "#.#") +
         ',"reason":"'    + why + '"' +
         ',"tag":"'       + channelTag + '"' +
         ',"bar":'        + str.tostring(time) +
         '}'
    alert(json, alert.freq_once_per_bar_close)
