# Clunoid App — environment template. Copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# ── Supabase (project ref: fgxjscoirazdkckcyory) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://fgxjscoirazdkckcyory.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase values (never exposed to the browser)
SUPABASE_URL=https://fgxjscoirazdkckcyory.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # service-equivalent; NOT used in normal RLS flows
SUPABASE_JWKS_URL=https://fgxjscoirazdkckcyory.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fgxjscoirazdkckcyory.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=fgxjscoirazdkckcyory
SUPABASE_ACCESS_TOKEN=sbp_...                 # account-level personal token (Management API / migrations)

# Google OAuth (configured in the Supabase dashboard; reference only)
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# Supabase OAuth callback: https://fgxjscoirazdkckcyory.supabase.co/auth/v1/callback

# ── AI brain & tools (added now; wired in upcoming steps) ────────────────────
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...
PEXELS_API_KEY=...
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=bIHbv24MWmeRgasZH58o

# Transactional email (Resend) — used as the Supabase SMTP password. Server-only.
RESEND_API_KEY=re_...

# Creator support bubble -> Telegram DM. Server-only: a bot token in the
# browser bundle is a bot anyone can send from. See docs/support-telegram.md.
TELEGRAM_BOT_TOKEN=1234567890:AA...
TELEGRAM_CHAT_ID=123456789
# Shared with Telegram when the webhook is registered, and checked on every
# incoming call. Any long random string; regenerate and re-register to rotate.
TELEGRAM_WEBHOOK_SECRET=...

# ── The signals channel: TradingView -> Telegram ──────────────────────────
# The public broadcast channel the Pine engine posts setups to. NOT the same
# destination as TELEGRAM_CHAT_ID above, which is one person's support DM —
# these two are deliberately separate so a change to one cannot redirect the
# other. The bot must be an administrator of the channel. A channel id starts
# with -100.
TELEGRAM_SIGNALS_CHAT_ID=-1001234567890

# Checked on every webhook call. TradingView cannot send custom headers, so
# this travels in the alert URL as ?secret=... — which makes the whole alert
# URL a credential: anyone holding it can post to the channel. Any long random
# string. Rotate by changing it here and editing the URL in each alert.
TRADINGVIEW_WEBHOOK_SECRET=...

# Only ever set this to point the signals pipeline at a local stub while
# testing. Unset in production, which is every environment that has not
# deliberately set it.
# TELEGRAM_API_BASE=http://localhost:3079
